    "extra_projection": false
  },
  "operators": {
    "L_bar": "0.5 * S_degree @ (B.T @ B) @ S_degree",
    "Q_bar": "S_diagQ @ (A.T @ A) @ S_diagQ / 3",
    "kappa_C": "max(diag(A.T@diag(c)@A)/diag(Q)) on positive diag(Q); 1 if no paths",
    "T_C_bar": "S_diagQ @ (A.T@diag(c)@A) @ S_diagQ / (3*kappa_C)",
    "polynomial": "L_bar @ L_bar",
    "inverse_sqrt_zero_diagonal": 0.0,
    "preconditioning": "global_uses_cached_topology_SQ; node_uses_current_C_diagonal_each_layer",
    "kappa_gradient": "preserved",
    "kappa_tie_gradient": "torch.amax_over_nodes_after_all_path_diagonal_sums_equal_gradient_on_tied_maxima",
    "psd_norm_upper_bound": 1.0,
    "exact_spectral_norm_equality_claim": false,
    "T_C_node": "S_diagTC @ (A.T@diag(c)@A) @ S_diagTC / 3",
    "S_diagTC": "inverse_sqrt(diag(A.T@diag(c)@A)); zero diagonal -> zero",
    "node_diagonal_gradient": "preserved_through_C_and_both_S_diagTC_factors",
    "condition_normalization": {
      "fixed_wedge": "fixed",
      "learned_wedge_raw": "global_kappa",
      "learned_wedge_rms": "global_kappa",
      "learned_wedge_local_raw": "node_diagonal",
      "learned_wedge_local_rms": "node_diagonal"
    },
    "conditional_operator_bound": "fixed_C_PSD_norm_at_most_one; no_full_nonlinear_Jacobian_claim"
  },
  "gate": {
    "input": "current_projected_Z_before_propagation",
    "channels_by_layer": [
      "8",
      "num_classes"
    ],
    "hidden_dim": 8,
    "architecture": "4F -> 8 -> 1",
    "activation": "relu",
    "first_linear_bias": true,
    "second_linear_bias": false,
    "features": [
      "abs(g1)+abs(g2)",
      "g1*g2",
      "abs(g2-g1)",
      "(abs(g1)-abs(g2))**2"
    ],
    "rms": "sqrt(sum((B@Z)**2)/(physical_edges*F)) per graph/layer/seed pooled across channels",
    "rms_zero_signal_scale": 1.0,
    "rms_nonzero_epsilon": 0.0,
    "c": "exp(tanh(score)) / mean_over_all_paths(exp(tanh(score)))",
    "tau": 1.0,
    "scalar_c_shared_across_channels": true,
